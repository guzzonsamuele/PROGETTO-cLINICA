									<id root="2.16.840.1.113883.2.9.4.3.2" extension="R_MidLatThigh"/>
									<playingDevice>
										<code displayName="Sensore Inerziale - coscia sinistra"/>
									</playingDevice>
								</participantRole>
							</participant>

							<participant typeCode="DEV">
