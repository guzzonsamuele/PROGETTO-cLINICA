						<list>
							<item ID="Procedure-Generale">
								<table border="1">
									<thead>
										<tr><th colspan="2">Dettagli Tecnici e Strumentazione</th></tr>
									</thead>
									<tbody>
										<tr>
											<th>Codice Studio</th>
											<td>62387-6 (Gait analysis study)</td>
										</tr>
										<tr>
											<th>Descrizione</th>
											<td>Valutazione multimodale del cammino e dell'equilibrio.</td>
										</tr>
										<tr>
											<th>Strumentazione utilizzata</th>
											<td>
												Sistema integrato composto da:
												<list>
													<item>13 Sensori inerziali MTw Awinda (Movella) posizionati su: fronte, sterno, L4/L5, polsi, cosce, stinchi, caviglie e dorso piedi.</item>
													<item>2 Solette sensorizzate Moticon OpenGo per pressioni plantari.</item>
													<item>Pedana baropodometrica ProtoKinetics Zeno™.</item>
												</list>
											</td>
										</tr>
										<tr>
											<th>Parametri analizzati</th>
											<td>Velocità, cadenza, lunghezza del passo e tempi di esecuzione.</td>
										</tr>
									</tbody>
								</table>
							</item>
						</list>
